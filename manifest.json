{
  "manifest_version": 3,
  "name": "speech_to_latex_extension",
  "version": "1.0",
  "description": "Dictate math and insert LaTeX in Overleaf via Whisper and Gemini.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
